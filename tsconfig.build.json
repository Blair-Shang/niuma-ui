{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/__tests__/**",
    "playground/**",
    "vite-plugins/**",
    "dist/**"
  ]
}
